{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "julia",
            "request": "launch",
            "name": "BuildRequirements",
            "program": "${workspaceFolder}/src/BuildRequirements.jl",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "RollupMassProps",
            "program": "${workspaceFolder}/src/RollupMassProps.jl",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "BuildTree",
            "program": "${workspaceFolder}/src/BuildTree.jl",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--max-depth", "7",
                "--max-width", "5",
                "--decomp-prob", "0.9",
                "--seed", "1",
                "--output", "${workspaceFolder}/build/wpx.json",
                "--table", "${workspaceFolder}/data/mp_table.tsv",
            ]
        },

        {
            "type": "julia",
            "request": "launch",
            "name": "MassPropsJson",
            "program": "${workspaceFolder}/src/MassPropsJson.jl",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--id", "child",
                "--pid", "parent",
                "--table", "${workspaceFolder}/data/mp_table.tsv",
                "--edgelist", "${workspaceFolder}/data/mp_edges.tsv",
                "--output", "${workspaceFolder}/build/wp5.json",
                "--reject", "[67890]"
            ],
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "BuildModel",
            "program": "${workspaceFolder}/src/BuildModel.jl",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--input", "${workspaceFolder}/build/wpx.json",
                "--limit", "0",
                "--defer-diagnostics",
                "--multi-level"
            ],
        }
    ]
}